APP_NAME=GCP Cloud Ops Automation Hub
ENVIRONMENT=development
API_PREFIX=/api/v1
DATABASE_URL=sqlite:///./cloud_ops.db
ALLOWED_INGEST_API_KEYS=dev-ingest-key
DEFAULT_GCP_PROJECT_ID=demo-project
ENABLE_RULE_ENGINE=true
DRY_RUN=true
LOG_LEVEL=INFO
WEBHOOK_TIMEOUT_SECONDS=10
SLACK_WEBHOOK_URL=
SLACK_DESTINATION_LABEL=platform-ops
NOTIFICATION_WEBHOOK_URL=
INCIDENT_WEBHOOK_URL=
AUTO_PROCESS_WORKFLOW_QUEUE=true
WORKFLOW_QUEUE_BATCH_SIZE=20
